# Copie para .env.local e preencha. Nada aqui é segredo — vai para o bundle público.

# URL pública do site, sem barra final. Ativa canonical, og:url/og:image e sitemap.xml.
VITE_SITE_URL=

# Endpoint que recebe o formulário de contato via POST JSON (ex.: Formspree, Getform
# ou função própria). Sem ele, o formulário informa que o envio online não está ativo.
VITE_CONTACT_ENDPOINT=
